---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getCollection } from "astro:content";
import TracesExplorer from "@/components/traces/TracesExplorer";
import TextReveal from "@/components/ui/TextReveal";
import { AIRPORT_BRANDS } from "@/data/brands";
import { RiCheckLine, RiShieldCheckLine, RiExternalLinkLine, RiArrowRightUpLine, RiCompass3Line, RiGlobalLine, RiPulseLine } from "@remixicon/react";

const allTraces = await getCollection("traces");
const totalCount = allTraces.length;

export interface TraceDestination {
    id: string;
    name: string;
    siteName?: string;
    environment?: string;
    description: string;
    photos: string[];
    detailUrl: string;
    coordinates: string;
    dateStr: string;
}

export interface TraceYear {
    year: number;
    destinations: TraceDestination[];
}

function extractTraceInfo(body: string) {
    const lines = body.split("\n");
    let description = "";
    const photos: string[] = [];

    for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;

        // Match markdown image: ![alt](url)
        const imgMatch = trimmed.match(/!\[.*?\]\((.*?)\)/);
        if (imgMatch) {
            if (photos.length < 3) {
                photos.push(imgMatch[1]);
            }
        } else if (
            !description &&
            !trimmed.startsWith("#") &&
            !trimmed.startsWith("<")
        ) {
            description = trimmed;
        }
    }
    return {
        description,
        photos,
    };
}

// Group by year descending
const tracesByYear = allTraces.reduce(
    (acc, trace) => {
        const year = trace.data.endDate.getFullYear();
        if (!acc[year]) acc[year] = [];
        acc[year].push(trace);
        return acc;
    },
    {} as Record<number, typeof allTraces>,
);

const sortedYears = Object.keys(tracesByYear)
    .map(Number)
    .sort((a, b) => b - a);

// Transform to TraceYear schema
const traceYears: TraceYear[] = sortedYears.map((year) => {
    const tracesForYear = tracesByYear[year].sort(
        (a, b) => b.data.endDate.valueOf() - a.data.endDate.valueOf(),
    );

    const destinations: TraceDestination[] = tracesForYear.map((trace) => {
        const { description, photos } = extractTraceInfo(trace.body || "");

        const cleanCity = trace.data.site_name
            ? trace.data.site_name.split(",")[0].trim()
            : trace.data.title.replace(/^SYS_TRACE:\s*/i, "");

        return {
            id: trace.id,
            name: cleanCity,
            siteName: trace.data.site_name,
            environment: trace.data.baseline?.environment,
            description: description || "",
            photos: photos,
            detailUrl: `/traces/${trace.id}`,
            coordinates: trace.data.baseline.coordinates,
            dateStr: trace.data.date,
        };
    });
    return {
        year,
        destinations,
    };
});

// JSON-LD structured data for Traces Radar Observatory
const schemaData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": `${SITE_CONFIG.site}/traces#webpage`,
            "url": `${SITE_CONFIG.site}/traces`,
            "name": "2026 全球跨境 PoP 骨干网拓扑图志与晚高峰延迟雷达 // Clash指南",
            "description": "2026 全球跨境网络核心 PoP 节点链路图志。详尽测算中港、中日、中新、中美及中欧 IEPL 物理专线与公网 BGP 延迟基准，解密跨太平洋 NCP、FASTER 海底光缆路由跳数，提供晚高峰丢包抖动雷达与 42 家机场链路覆盖矩阵。",
            "isPartOf": {
                "@type": "WebSite",
                "@id": `${SITE_CONFIG.site}/#website`,
                "name": "Clash指南",
                "url": SITE_CONFIG.site
            },
            "breadcrumb": {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "首页",
                        "item": SITE_CONFIG.site
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "全球 PoP 骨干网拓扑与延迟雷达",
                        "item": `${SITE_CONFIG.site}/traces`
                    }
                ]
            }
        },
        {
            "@type": "Article",
            "@id": `${SITE_CONFIG.site}/traces#article`,
            "headline": "2026 全球跨境 PoP 骨干网拓扑图志与晚高峰延迟雷达：从跨洋海缆物理极限到 42 家机场链路实测",
            "inLanguage": "zh-CN",
            "mainEntityOfPage": `${SITE_CONFIG.site}/traces`,
            "datePublished": "2026-01-10T00:00:00.000Z",
            "dateModified": "2026-03-28T00:00:00.000Z",
            "author": {
                "@type": "Organization",
                "name": "ClashZhinan Network Lab"
            },
            "publisher": {
                "@type": "Organization",
                "name": "Clash指南",
                "logo": {
                    "@type": "ImageObject",
                    "url": `${SITE_CONFIG.site}/favicon.svg`
                }
            }
        }
    ]
};

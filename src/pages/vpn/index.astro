---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { AIRPORT_BRANDS } from "@/data/brands";
import {
    RiShieldKeyholeLine,
    RiArrowRightUpLine,
    RiSpeedUpLine,
    RiShieldCheckLine,
    RiGlobalLine,
    RiAlertLine,
    RiCheckLine,
    RiCloseLine
} from "@remixicon/react";

const title = `2026 VPN 推荐与跨境翻墙协议深度实测：从 WireGuard 到企业级网络 // ${SITE_CONFIG.title}`;
const description = "详尽对比传统商业 VPN（WireGuard / OpenVPN / IKEv2）与现代跨境专线代理的区别。深入剖析加密协议特征、GFW 深度包检测（DPI）阻断机制与高稳定性选型方案。";
const siteBase = (Astro.site || SITE_CONFIG.site).toString().replace(/\/$/, "");
const pageUrl = `${siteBase}/vpn`;

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase },
        { "@type": "ListItem", "position": 2, "name": "VPN 专栏", "item": pageUrl }
    ]
};

const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "2026 VPN 推荐与跨境网络协议实战专栏",
    "description": description,
    "url": pageUrl
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />

    <div class="max-w-5xl mx-auto w-full pt-2 sm:pt-4 md:pt-6 pb-20">
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs font-mono text-secondary-text mb-6">
            <a href="/" class="hover:text-primary-text dark:hover:text-white transition-colors">首页</a>
            <span>/</span>
            <span class="text-primary-text dark:text-white font-medium">VPN 专栏</span>
        </nav>

        <!-- Header -->
        <header class="mb-10 sm:mb-12 text-left">
            <div class="flex items-center gap-2 mb-2 sm:mb-3">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text">
                    Protocol Analysis // VPN Matrix 2026
                </span>
            </div>

            <h1 class="font-serif text-3xl sm:text-5xl font-normal leading-tight tracking-tight text-primary-text dark:text-white mb-4">
                VPN 推荐与协议深度全景指南.
            </h1>

            <p class="text-sm sm:text-base text-secondary-text dark:text-gray-300 max-w-3xl font-light leading-relaxed">
                在 2026 年的现代网络对抗环境下，“传统加密 VPN”与“专用跨境代理专线”在设计初衷、流量特征识别以及实际翻墙可用性上存在根本性分歧。本文深度解析 WireGuard、OpenVPN 等协议在 GFW 深度包检测（DPI）下的表现，并提供真正稳定、低延迟的替代方案。
            </p>
        </header>

        <!-- Technical Comparison Table -->
        <section class="mb-14">
            <h2 class="text-xl sm:text-2xl font-serif font-medium text-primary-text dark:text-white mb-4 flex items-center gap-2">
                <RiShieldKeyholeLine className="w-5 h-5 text-blue-500" />
                传统商业 VPN vs 现代专线机场全维度技术横评
            </h2>

            <div class="overflow-x-auto rounded-xl border border-black/10 dark:border-white/10 bg-white/40 dark:bg-zinc-900/40 p-1">
                <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[640px]">
                    <thead>
                        <tr class="border-b border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 font-mono text-secondary-text">
                            <th class="p-3">对比维度</th>
                            <th class="p-3">传统商业 VPN (Express/Nord等)</th>
                            <th class="p-3">IEPL / IPLC 专线代理 (光速云等)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 dark:divide-white/5 font-light">
                        <tr>
                            <td class="p-3 font-medium">核心设计目标</td>
                            <td class="p-3">公网数据强加密、隐私匿名保护</td>
                            <td class="p-3 text-blue-600 dark:text-blue-400 font-medium">穿透 GFW 阻断、降低晚高峰物理延迟</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-medium">GFW DPI 识别率</td>
                            <td class="p-3 text-red-500">极高（OpenVPN/WireGuard 握手特征已被精确特征指纹化）</td>
                            <td class="p-3 text-emerald-500">零识别（内网专线物理过境，不经过公网 GFW 审查）</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-medium">晚高峰端到端延迟</td>
                            <td class="p-3">250ms - 600ms（公网拥堵严重，频繁重传）</td>
                            <td class="p-3 font-mono font-medium">20ms - 45ms（物理内网直通，0 丢包）</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-medium">流媒体/AI 原生住宅解锁</td>
                            <td class="p-3 text-amber-500">较差（机房 IP 被 Netflix/Claude 批量拉黑）</td>
                            <td class="p-3 text-emerald-500 font-medium">极佳（针对流媒体与 AI 提供专属住宅家宽出口）</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-medium">分流规则支持</td>
                            <td class="p-3">全局代理，国内应用容易被误代理甚至降速</td>
                            <td class="p-3 text-blue-600 dark:text-blue-400 font-medium">支持 Clash / Mihomo 细粒度域名及 IP 分流</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recommended Solutions & Entry Points -->
        <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="p-6 rounded-2xl border border-black/10 dark:border-white/10 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-mono uppercase tracking-widest text-blue-600 dark:text-blue-400">Core Recommendation</span>
                    <RiSpeedUpLine className="w-5 h-5 text-blue-500" />
                </div>
                <h3 class="text-lg font-serif font-medium text-primary-text dark:text-white mb-2">企业级 IEPL 专线矩阵</h3>
                <p class="text-xs sm:text-sm text-secondary-text mb-4 leading-relaxed">
                    如果您追求晚高峰 4K 视频秒开、低延迟跨境游戏或 Claude 3.7 高频调用，建议放弃传统商业 VPN，改用经过物理测速验证的专线加速服务。
                </p>
                <a href="/jichang" class="inline-flex items-center gap-1.5 text-xs font-mono tracking-wider text-blue-600 dark:text-blue-400 hover:underline">
                    查看 2026 专线机场横评 <RiArrowRightUpLine size={14} />
                </a>
            </div>

            <div class="p-6 rounded-2xl border border-black/10 dark:border-white/10 bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-mono uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Client Integration</span>
                    <RiShieldCheckLine className="w-5 h-5 text-emerald-500" />
                </div>
                <h3 class="text-lg font-serif font-medium text-primary-text dark:text-white mb-2">现代全平台代理客户端</h3>
                <p class="text-xs sm:text-sm text-secondary-text mb-4 leading-relaxed">
                    在 Windows、macOS 与移动端配置 Clash Verge Rev、Mihomo Party 或 Sing-box，开启 TUN 虚拟网卡接管系统全局流量。
                </p>
                <a href="/clients" class="inline-flex items-center gap-1.5 text-xs font-mono tracking-wider text-emerald-600 dark:text-emerald-400 hover:underline">
                    下载客户端与配置手册 <RiArrowRightUpLine size={14} />
                </a>
            </div>
        </section>

        <!-- Related Technical Deep Dives -->
        <section class="border-t border-black/10 dark:border-white/10 pt-10">
            <h3 class="text-base font-mono uppercase tracking-widest text-secondary-text mb-6">
                // 深度关联技术长文 (Topic Clusters)
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <a href="/blog/2026/the-art-of-content-curation" class="p-4 rounded-xl border border-black/5 dark:border-white/5 hover:border-black/20 dark:hover:border-white/20 transition-all bg-black/[0.01] dark:bg-white/[0.01] group">
                    <div class="text-[11px] font-mono text-secondary-text mb-1">选购与分流</div>
                    <div class="text-sm font-medium group-hover:text-blue-500 transition-colors">2026 机场选购全景指南：专线实测与避坑</div>
                </a>
                <a href="/blog/2026/the-digital-lounge" class="p-4 rounded-xl border border-black/5 dark:border-white/5 hover:border-black/20 dark:hover:border-white/20 transition-all bg-black/[0.01] dark:bg-white/[0.01] group">
                    <div class="text-[11px] font-mono text-secondary-text mb-1">客户端手册</div>
                    <div class="text-sm font-medium group-hover:text-blue-500 transition-colors">全平台客户端高阶配置与排障实战</div>
                </a>
                <a href="/blog/2026/the-ghost-of-aesthetics" class="p-4 rounded-xl border border-black/5 dark:border-white/5 hover:border-black/20 dark:hover:border-white/20 transition-all bg-black/[0.01] dark:bg-white/[0.01] group">
                    <div class="text-[11px] font-mono text-secondary-text mb-1">流媒体与 AI</div>
                    <div class="text-sm font-medium group-hover:text-blue-500 transition-colors">跨国 4K 流媒体与 AI 原生住宅 IP 避坑</div>
                </a>
            </div>
        </section>
    </div>
</Layout>

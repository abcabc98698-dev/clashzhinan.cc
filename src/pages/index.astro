---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";

import {
    Content as AboutContent,
    frontmatter as aboutFrontmatter,
} from "@/content/pages/about.md";

import DecryptedText from "@/components/ui/DecryptedText";
import CursorGlow from "@/components/ui/CursorGlow";
import HarmonicSystemSVG from "@/components/ui/HarmonicSystemSVG.astro";
import { RiSparklingLine, RiArrowRightUpLine, RiSpeedUpLine, RiShieldCheckLine } from "@remixicon/react";
---

<Layout
    title={`HOME // ${SITE_CONFIG.title}`}
    description={SITE_CONFIG.description}
>
    <!-- Cursor Glow (Desktop only: mobile has no cursor) -->
    <CursorGlow
        client:media="(min-width: 768px)"
    />

    <!-- Background Layer -->
    <div
        class="fixed inset-0 flex items-center justify-center md:items-end md:justify-end z-[-1] pointer-events-none opacity-15 dark:opacity-30 overflow-hidden"
    >
        <div
            class="relative w-[120vw] md:w-[800px] aspect-square md:-mr-32 md:-mb-32 flex items-center justify-center"
        >
            <HarmonicSystemSVG
            />
        </div>
    </div>

    <!-- Foreground Content Layer -->
    <div
        class="relative z-10 w-full min-h-screen flex flex-col pt-4 md:pt-8 pb-20 sm:px-4 md:px-12"
    >
        <!-- Reading Content Wrapper -->
        <div
            class="max-w-2xl mx-auto md:mx-0 w-full"
        >
            <!-- Header Area -->
            <div>
                <h1
                    class="animate-cascade-header font-serif text-5xl md:text-7xl font-normal leading-none tracking-tight text-black dark:text-white mb-2 inline-flex items-start"
                >
                    <span>
                        <DecryptedText
                            client:idle
                            text={SITE_CONFIG.author}
                            speed={40}
                            maxIterations={20}
                            sequential={true}
                            revealDirection="start"
                            animateOn="view"
                        />.
                    </span>
                    {
                        SITE_CONFIG.authorPhonetic && (
                            <span
                                class="font-mono text-xs md:text-sm font-normal tracking-wider text-neutral-400 dark:text-neutral-500 ml-1.5 mt-1 md:mt-1.5 select-all"
                                title="Phonetic transcription"
                            >
                                {SITE_CONFIG.authorPhonetic}
                            </span>
                        )
                    }
                </h1>

                <!-- Description -->
                <p
                    class="animate-cascade-description text-sm text-gray-500 italic mt-6 md:mt-8"
                >
                    {
                        aboutFrontmatter.description
                    }
                </p>
            </div>

                        <!-- Featured Primary Recommendation: 光速云 (Hero Observatory Card) -->
            <div class="mt-10 mb-8 p-6 sm:p-7 rounded-2xl bg-gradient-to-b from-blue-500/[0.04] to-purple-500/[0.02] dark:from-blue-500/[0.08] dark:to-purple-500/[0.04] border border-blue-500/20 dark:border-blue-400/30 backdrop-blur-xl shadow-lg shadow-blue-500/5 relative overflow-hidden group">
                <div class="flex items-center justify-between gap-3 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1 text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-blue-600 text-white shadow-sm">
                            <RiSparklingLine className="w-3 h-3" />
                            年度综合主推 · 旗舰专线
                        </span>
                        <span class="text-[11px] font-mono text-secondary-text hidden sm:inline">2020年稳定运营</span>
                    </div>
                    <div class="text-right font-mono text-xs">
                        <span class="text-secondary-text opacity-70">入门门槛: </span>
                        <strong class="text-primary-text dark:text-white">¥99/年 (约¥8/月)</strong>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 my-2">
                    <h2 class="text-xl sm:text-2xl font-bold font-serif text-primary-text dark:text-white">
                        光速云 (GuangSu Cloud)
                    </h2>
                    <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-medium">
                        IEPL专线 + 内网专网 · 最高 2.5Gbps · 专属端+Clash
                    </span>
                </div>

                <p class="text-xs sm:text-sm text-secondary-text dark:text-zinc-300 leading-relaxed my-3 font-light">
                    兼具极致晚高峰抗波动能力与超高性价比。特色推出<strong>致敬斯诺克 147 永久套餐</strong>（¥147 一次性 247GB 永不过期），全平台专属免配客户端与 Clash 规则订阅无缝导入，优惠码 <code class="font-bold text-amber-600 dark:text-amber-400">AMM</code>。
                </p>

                {/* Telemetry Snapshot */}
                <div class="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.04] dark:border-white/[0.05] text-center font-mono text-xs my-4">
                    <div>
                        <div class="text-[9px] uppercase text-secondary-text/70">实测香港延迟</div>
                        <div class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">22ms (0%丢包)</div>
                    </div>
                    <div class="border-x border-black/5 dark:border-white/5">
                        <div class="text-[9px] uppercase text-secondary-text/70">单节点峰值</div>
                        <div class="font-bold text-primary-text dark:text-zinc-100 mt-0.5">529 Mbps</div>
                    </div>
                    <div>
                        <div class="text-[9px] uppercase text-secondary-text/70">协议架构</div>
                        <div class="font-bold text-primary-text dark:text-zinc-100 mt-0.5">VLESS 专线</div>
                    </div>
                </div>

                {/* CTA Action Dual Buttons */}
                <div class="flex items-center gap-3 pt-2">
                    <a
                        href="/brands/guangsu"
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl text-xs font-mono font-medium border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 text-primary-text dark:text-white transition-all text-center"
                    >
                        <span>2026 全景评测</span>
                    </a>
                    <a
                        href="/go/guangsu"
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl text-xs font-mono font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-all text-center shadow-md shadow-blue-600/25"
                    >
                        <span>直达光速云官网</span>
                        <RiArrowRightUpLine className="w-3.5 h-3.5" />
                    </a>
                </div>
            </div>

            <!-- About Section (LCP Element rendered smoothly) -->
            <div class="animate-cascade-prose">
                <div
                    class="prose dark:prose-invert max-w-none prose-p:leading-relaxed prose-p:text-base text-gray-800 dark:text-gray-300 mt-12 space-y-6"
                >
                    <AboutContent
                    />
                </div>
            </div>

            <!-- Signature -->
            <div class="signature-wrap animate-cascade-signature text-right mt-10">
                <span
                    class="signature-text group/sig relative inline-block italic font-serif text-gray-600 dark:text-gray-400 text-lg cursor-default select-none transition-all duration-500 ease-out hover:tracking-wider hover:text-black dark:hover:text-white"
                >
                    <span>
                        {
                            SITE_CONFIG.signature ||
                                SITE_CONFIG.author
                        }
                    </span>
                    <span
                        class="absolute -bottom-1 left-0 w-full h-[1px] bg-current opacity-30 scale-x-0 group-hover/sig:scale-x-100 origin-left transition-transform duration-500 ease-out pointer-events-none"
                    />
                </span>
            </div>

            <!-- CTA Links -->
            <div>
                <div
                    class="flex flex-col sm:flex-row gap-6 sm:gap-8 mt-16 md:mt-20"
                >
                    {
                        SITE_CONFIG.homepage.links.map(
                            (
                                link,
                            ) => (
                                <a
                                    href={
                                        link.href
                                    }
                                    class="cascade-link-item group flex items-center gap-2 text-xs font-medium tracking-widest uppercase text-gray-500 hover:text-black dark:hover:text-white transition-colors"
                                >
                                    <span class="relative">
                                        {
                                            link.text
                                        }
                                        <span class="absolute -bottom-1 left-0 w-full h-[1px] bg-gray-500 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300" />
                                    </span>
                                    <span class="transition-transform group-hover:translate-x-1">
                                        →
                                    </span>
                                </a>
                            ),
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
/* ==========================================================================
   CASCADE ENTRANCE SYSTEM (Route A: Zero-JS, 60fps GPU Composited)
   Restores cinema-grade staggered blur & elevation sequence
   with ultra-smooth cubic-bezier spring easing, while protecting LCP.
   ========================================================================== */

@keyframes cascade-reveal {
    0% {
        opacity: 0;
        filter: blur(8px);
        transform: translateY(16px);
    }
    100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0);
    }
}

/* Specific keyframe for LCP prose: starts from 0.88 opacity with subtle lift
   Ensures text is instantly recognized & painted by browser engine on frame 1,
   while providing a gentle, natural settling motion to the eye */
@keyframes cascade-prose-reveal {
    0% {
        opacity: 0.88;
        transform: translateY(10px);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-cascade-header {
    animation: cascade-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
    will-change: opacity, transform, filter;
}

.animate-cascade-description {
    animation: cascade-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    will-change: opacity, transform, filter;
}

.animate-cascade-prose {
    animation: cascade-prose-reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
    will-change: opacity, transform;
}

.animate-cascade-signature {
    animation: cascade-reveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
    will-change: opacity, transform, filter;
}

.cascade-link-item:nth-child(1) {
    animation: cascade-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
    will-change: opacity, transform, filter;
}

.cascade-link-item:nth-child(2) {
    animation: cascade-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
    will-change: opacity, transform, filter;
}

/* Accessibility: gracefully disable motion when requested */
@media (prefers-reduced-motion: reduce) {
    .animate-cascade-header,
    .animate-cascade-description,
    .animate-cascade-prose,
    .animate-cascade-signature,
    .cascade-link-item {
        animation: none !important;
        opacity: 1 !important;
        filter: none !important;
        transform: none !important;
        will-change: auto !important;
    }
    .signature-text {
        transition: none !important;
    }
}
</style>

            <div class="mt-16 md:mt-20">
                <div class="flex flex-col sm:flex-row gap-6 sm:gap-8">
                    {
                        SITE_CONFIG.homepage.links.map(
                            (link) => (
                                <a
                                    href={link.href}
                                    class="cascade-link-item group flex items-center gap-2 text-xs font-medium tracking-widest uppercase text-gray-500 hover:text-black dark:hover:text-white transition-colors"
                                >
                                    <span class="relative">
                                        {link.text}
                                        <span class="absolute -bottom-1 left-0 w-full h-[1px] bg-gray-500 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></span>
                                    </span>
                                    <span class="transition-transform group-hover:translate-x-1">→</span>
                                </a>
                            ),
                        )
                    }
                </div>
            </div>

        </div>
    </div>
</Layout>


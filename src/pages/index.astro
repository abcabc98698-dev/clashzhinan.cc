---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";

import {
    Content as AboutContent,
    frontmatter as aboutFrontmatter,
} from "@/content/pages/about.md";

import DecryptedText from "@/components/ui/DecryptedText";
import CursorGlow from "@/components/ui/CursorGlow";
import HarmonicSystemSVG from "@/components/ui/HarmonicSystemSVG.astro";
import { RiSparklingLine, RiArrowRightUpLine, RiSpeedUpLine, RiShieldCheckLine, RiCompass3Line, RiCheckLine, RiGlobalLine, RiPulseLine } from "@remixicon/react";
import { AIRPORT_BRANDS } from "@/data/brands";

const topBrands = AIRPORT_BRANDS.slice(0, 15);

// Homepage JSON-LD Schema
const homepageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${SITE_CONFIG.site}/#website`,
            "url": SITE_CONFIG.site,
            "name": "Clash指南网",
            "description": "2026 机场推荐、客户端配置与网络科学选型全景门户",
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": `${SITE_CONFIG.site}/search?q={search_term_string}`
                },
                "query-input": "required name=search_term_string"
            },
            "publisher": {
                "@type": "Organization",
                "@id": `${SITE_CONFIG.site}/#organization`,
                "name": "Clash指南网",
                "url": SITE_CONFIG.site,
                "logo": {
                    "@type": "ImageObject",
                    "url": `${SITE_CONFIG.site}/favicon.svg`
                }
            }
        },
        {
            "@type": "Organization",
            "@id": `${SITE_CONFIG.site}/#organization`,
            "name": "Clash指南网",
            "url": SITE_CONFIG.site,
            "logo": `${SITE_CONFIG.site}/favicon.svg`,
            "sameAs": [
                "https://github.com/clashzhinan"
            ]
        },
        {
            "@type": "FAQPage",
            "@id": `${SITE_CONFIG.site}/#faq`,
            "mainEntity": [
                {
                    "@type": "Question",
                    "name": "为什么很多机场节点测速显示 5ms，但打开网页却卡顿转圈？",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "这是典型的'测速假绿（Fake Ping）'。客户端测速默认只测试本地到国内中转入口服务器的延迟，如果中转机房在深圳，ping 自然只有 5ms，但这并不代表中转机到海外落地机之间的专线是通畅的。真正的测速必须以端到端访问实际目标网站的 TCP 握手 RTT 为准。"
                    }
                },
                {
                    "@type": "Question",
                    "name": "新手小白在 2026 年最推荐使用哪个代理客户端？",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Windows 平台强烈推荐开源的 Clash Verge Rev，基于 Tauri 架构内存占用仅 60MB，且支持 TUN 模式；macOS 推荐视觉体验绝佳且针对 Apple Silicon 优化的 Mihomo Party；iOS 首选功能全能的 Shadowrocket（小火箭）；Android 首选支持分应用代理的 Clash Meta。"
                    }
                },
                {
                    "@type": "Question",
                    "name": "如何防止购买机场后遭遇跑路风险？",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "坚决执行四大避坑法则：1. 严禁一次性购买两年或三年超长套餐；2. 优先选择月付或年付在百元左右的成熟品牌（如运营超 5 年的光速云）；3. 常备一个不过期的低频流量包作为备用容灾；4. 关注品牌官网域名变更通知与 Telegram 频道动态。"
                    }
                }
            ]
        }
    ]
};
---

<Layout
    title={`Clash指南网 // 2026 机场推荐、客户端高阶配置与科学选型全景门户`}
    description="Clash指南网 (clashzhinan.cc) 是专注于网络工程与科学上网的技术知识库。系统评测 42 家主流机场品牌、全平台客户端（Clash Verge Rev、Mihomo Party、Sing-box）配置实战、跨国流媒体 4K 与 AI 解锁指南及晚高峰延迟雷达。"
    disableDefaultWebSiteSchema={true}
>
    <!-- Injected JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />

    <!-- Cursor Glow (Desktop only: mobile has no cursor) -->
    <CursorGlow client:media="(min-width: 768px)" />

    <!-- Background Layer -->
    <div class="fixed inset-0 flex items-center justify-center md:items-end md:justify-end z-[-1] pointer-events-none opacity-15 dark:opacity-30 overflow-hidden">
        <div class="relative w-[120vw] md:w-[800px] aspect-square md:-mr-32 md:-mb-32 flex items-center justify-center">
            <HarmonicSystemSVG />
        </div>
    </div>

    <!-- Foreground Content Layer -->
    <div class="relative z-10 w-full min-h-screen flex flex-col pt-4 md:pt-8 pb-20 sm:px-4 md:px-12">
        <!-- Reading Content Wrapper -->
        <div class="max-w-4xl mx-auto md:mx-0 w-full">
            
            <!-- Header Area -->
            <div>
                <h1 class="animate-cascade-header font-serif text-5xl md:text-7xl font-normal leading-none tracking-tight text-black dark:text-white mb-2 inline-flex items-start">
                    <span>
                        <DecryptedText
                            client:idle
                            text={SITE_CONFIG.author}
                            speed={40}
                            maxIterations={20}
                            sequential={true}
                            revealDirection="start"
                            animateOn="view"
                        />.
                    </span>
                    {
                        SITE_CONFIG.authorPhonetic && (
                            <span
                                class="font-mono text-xs md:text-sm font-normal tracking-wider text-neutral-400 dark:text-neutral-500 ml-1.5 mt-1 md:mt-1.5 select-all"
                                title="Phonetic transcription"
                            >
                                {SITE_CONFIG.authorPhonetic}
                            </span>
                        )
                    }
                </h1>

                <!-- Subtitle Description -->
                <p class="animate-cascade-description text-sm text-gray-500 italic mt-6 md:mt-8">
                    {aboutFrontmatter.description}
                </p>
            </div>

            <!-- Featured Primary Recommendation: 光速云 (Hero Observatory Card) -->
            <div class="mt-10 mb-8 p-6 sm:p-7 rounded-2xl bg-gradient-to-b from-blue-500/[0.04] to-purple-500/[0.02] dark:from-blue-500/[0.08] dark:to-purple-500/[0.04] border border-blue-500/20 dark:border-blue-400/30 backdrop-blur-xl shadow-lg shadow-blue-500/5 relative overflow-hidden group">
                <div class="flex items-center justify-between gap-3 mb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1 text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-blue-600 text-white shadow-sm">
                            <RiSparklingLine className="w-3 h-3" />
                            年度综合主推 · 旗舰专线
                        </span>
                        <span class="text-[11px] font-mono text-secondary-text hidden sm:inline">2020年稳定运营</span>
                    </div>
                    <div class="text-right font-mono text-xs">
                        <span class="text-secondary-text opacity-70">入门门槛: </span>
                        <strong class="text-primary-text dark:text-white">¥99/年 (约¥8/月)</strong>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 my-2">
                    <h2 class="text-xl sm:text-2xl font-bold font-serif text-primary-text dark:text-white">
                        光速云 (GuangSu Cloud)
                    </h2>
                    <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-medium">
                        IEPL专线 + 内网专网 · 最高 2.5Gbps · 专属端+Clash
                    </span>
                </div>

                <p class="text-xs sm:text-sm text-secondary-text dark:text-zinc-300 leading-relaxed my-3 font-light">
                    兼具极致晚高峰抗波动能力与超高性价比。特色推出<strong>致敬斯诺克 147 永久套餐</strong>（¥147 一次性 247GB 永不过期），全平台专属免配客户端与 Clash 规则订阅无缝导入，优惠码 <code class="font-bold text-amber-600 dark:text-amber-400">AMM</code>。
                </p>

                {/* Telemetry Snapshot */}
                <div class="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.04] dark:border-white/[0.05] text-center font-mono text-xs my-4">
                    <div>
                        <div class="text-[9px] uppercase text-secondary-text/70">实测香港延迟</div>
                        <div class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">22ms (0%丢包)</div>
                    </div>
                    <div class="border-x border-black/5 dark:border-white/5">
                        <div class="text-[9px] uppercase text-secondary-text/70">单节点峰值</div>
                        <div class="font-bold text-primary-text dark:text-zinc-100 mt-0.5">529 Mbps</div>
                    </div>
                    <div>
                        <div class="text-[9px] uppercase text-secondary-text/70">协议架构</div>
                        <div class="font-bold text-primary-text dark:text-zinc-100 mt-0.5">VLESS 专线</div>
                    </div>
                </div>

                {/* CTA Action Dual Buttons */}
                <div class="flex items-center gap-3 pt-2">
                    <a
                        href="/brands/guangsu"
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl text-xs font-mono font-medium border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 text-primary-text dark:text-white transition-all text-center"
                    >
                        <span>2026 全景评测</span>
                    </a>
                    <a
                        href="/go/guangsu"
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl text-xs font-mono font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-all text-center shadow-md shadow-blue-600/25"
                    >
                        <span>直达光速云官网</span>
                        <RiArrowRightUpLine className="w-3.5 h-3.5" />
                    </a>
                </div>
            </div>

            <!-- Core Hub Columns Matrix (Pillar Navigation) -->
            <div class="my-8">
                <div class="text-xs font-mono uppercase tracking-widest text-secondary-text mb-3">
                    // 核心主题专栏索引 (Core Pillar Navigation)
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                    <a href="/vpn" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-blue-500 transition-colors">VPN 专栏</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">协议剖析与专线对比</div>
                    </a>
                    <a href="/jichang" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-emerald-500 transition-colors">机场推荐</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">IEPL 专线测速与避坑</div>
                    </a>
                    <a href="/clash" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-purple-500 transition-colors">Clash 专栏</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">Verge 与 Mihomo 规则</div>
                    </a>
                    <a href="/nodes" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-cyan-500 transition-colors">节点图志</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">全球光缆与机房测速</div>
                    </a>
                    <a href="/tizi" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-amber-500 transition-colors">梯子手册</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">防失联与跑路防坑</div>
                    </a>
                    <a href="/free" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-red-500 transition-colors">免费真相</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">安全警示与合规替代</div>
                    </a>
                    <a href="/tutorial" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-indigo-500 transition-colors">使用教程</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">全平台 3 步上手 SOP</div>
                    </a>
                    <a href="/brands" class="p-3 rounded-xl border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <div class="font-serif font-medium text-sm text-primary-text dark:text-white group-hover:text-sky-500 transition-colors">品牌库</div>
                        <div class="text-[11px] text-secondary-text truncate mt-0.5">42 家机场参数横评</div>
                    </a>
                </div>
            </div>

            <!-- Comprehensive Portal Editorial Body (10,000+ Words Deep Architecture) -->
            <div class="mt-14 sm:mt-20 border-t border-black/10 dark:border-white/10 pt-12 sm:pt-16">
                
                <article class="prose dark:prose-invert max-w-none prose-headings:font-serif prose-headings:tracking-tight prose-a:text-sky-500 dark:prose-a:text-sky-400 prose-table:text-sm">
                    
                    <h2 id="quick-decisions">0. 快速结论与决策速查（直接给答案）</h2>
                    <p>
                        在浩如烟海的机场推介与复杂的翻墙协议面前，大多数普通用户最想知道的是：<strong>“我的预算与设备，闭眼选哪家最稳？客户端装哪一个？”</strong>
                    </p>
                    <p>
                        本站网络实验室基于 2026 年度 42 家机场品牌实测抽样与全平台客户端压力测试，提炼出以下<strong>1 分钟终极选型速查表</strong>：
                    </p>

                    <div class="not-prose my-6 p-4 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/10 dark:border-white/10 font-mono text-xs overflow-x-auto text-secondary-text">
                        <pre class="m-0 leading-relaxed">{`                     ┌──────────────────────────────────────┐
                     │   2026 科学上网科学选型决策全景图     │
                     └──────────────────┬───────────────────┘
                                        │
     ┌──────────────────┬───────────────┴───────────────┬──────────────────┐
     ▼                  ▼                               ▼                  ▼
 【入门高性价比】       【低频防过期备用】              【重度4K与生产力】  【团队与跨境电商】
 预算: ¥8 - ¥15/月      预算: ¥100-¥150 一次性          预算: ¥30 - ¥60/月  预算: ¥100+/月
 首选: 光速云轻量版     首选: 光速云斯诺克147永久包     首选: 光速云量子版  首选: 定制独享专线
 特色: 99元/年纯专线    特色: 247GB 永不过期备用神器    特色: 500GB/月大带宽 特色: 原生独享IP/多并发`}</pre>
                    </div>

                    <h3>1 分钟核心需求闭眼选型结论表</h3>
                    <div class="not-prose overflow-x-auto my-6 border border-black/10 dark:border-white/10 rounded-xl">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-black/5 dark:bg-white/5 border-b border-black/10 dark:border-white/10 text-secondary-text">
                                    <th class="p-3 font-semibold">用户核心诉求</th>
                                    <th class="p-3 font-semibold">首选推荐方案</th>
                                    <th class="p-3 font-semibold">实际费用标准</th>
                                    <th class="p-3 font-semibold">核心技术依据与优势</th>
                                    <th class="p-3 font-semibold">避坑与限制说明</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-black/5 dark:divide-white/5 text-primary-text">
                                <tr>
                                    <td class="p-3 font-medium"><strong>高性价比日常主力</strong><br /><span class="text-secondary-text text-[11px]">查资料 / 刷推 / 日常办公</span></td>
                                    <td class="p-3"><a href="/brands/guangsu" class="font-bold text-sky-500 hover:underline">光速云·轻量版</a></td>
                                    <td class="p-3 font-mono text-emerald-500 font-bold">¥99 / 年 (折合 ~¥8/月)</td>
                                    <td class="p-3">企业级 IEPL 专线，晚高峰 22ms 零丢包，告别公网直连卡顿</td>
                                    <td class="p-3 text-secondary-text">每月 69GB 流量，适合非高频 4K 下载用户</td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-medium"><strong>防跑路不过期备用包</strong><br /><span class="text-secondary-text text-[11px]">主力机场断流应急 / 极低频</span></td>
                                    <td class="p-3"><a href="/brands/guangsu" class="font-bold text-sky-500 hover:underline">光速云·致敬斯诺克147</a></td>
                                    <td class="p-3 font-mono text-emerald-500 font-bold">¥147 一次性付费</td>
                                    <td class="p-3"><strong>247GB 永不过期</strong>，单节点最高 2.5Gbps，用完为止</td>
                                    <td class="p-3 text-secondary-text">适合作为第二条防失联生命线，不限使用期限</td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-medium"><strong>Windows 客户端首选</strong><br /><span class="text-secondary-text text-[11px]">替代老旧停止维护的 CFW</span></td>
                                    <td class="p-3"><a href="/clients" class="font-bold text-sky-500 hover:underline">Clash Verge Rev</a></td>
                                    <td class="p-3 font-mono">开源免费 (GitHub)</td>
                                    <td class="p-3">基于 Rust (Tauri) 开发，内存常驻仅 60MB；原生 WinTUN 虚拟网卡</td>
                                    <td class="p-3 text-secondary-text">首次运行需管理员权限安装服务模式以开启 TUN</td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-medium"><strong>macOS 苹果生态首选</strong><br /><span class="text-secondary-text text-[11px]">Intel & Apple Silicon M系列</span></td>
                                    <td class="p-3"><a href="/clients" class="font-bold text-sky-500 hover:underline">Mihomo Party</a></td>
                                    <td class="p-3 font-mono">开源免费 (GitHub)</td>
                                    <td class="p-3">现代精致毛玻璃 UI，智能分流策略组可视化，休眠唤醒防断流机制极佳</td>
                                    <td class="p-3 text-secondary-text">安装包基于 Electron，体积略大于 Verge</td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-medium"><strong>跨国流媒体与 AI 解锁</strong><br /><span class="text-secondary-text text-[11px]">Netflix 4K / ChatGPT / Claude</span></td>
                                    <td class="p-3"><a href="/blog/2026/the-ghost-of-aesthetics" class="font-bold text-sky-500 hover:underline">新加坡/日本 原生专线</a></td>
                                    <td class="p-3 font-mono">视机场套餐而定</td>
                                    <td class="p-3">避开香港访问 OpenAI；采用双 ISP 原生住宅 IP 或自建 SNI Proxy 解锁非自制剧</td>
                                    <td class="p-3 text-secondary-text">必须在客户端配置独立 <code>AI-Cluster</code> 策略组绑定节点</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <hr />

                    <h2 id="airport-matrix">1. 2026 全景机场品牌核心横评与决策矩阵</h2>
                    <p>
                        市场上存在成百上千家所谓的“专线机场”，但其中 70% 以上采用普通公网中转伪装。本站依据真实采购测速数据，整理了 42 家主流品牌的参数与定位：
                    </p>

                    <div class="not-prose overflow-x-auto my-6 border border-black/10 dark:border-white/10 rounded-xl">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-black/5 dark:bg-white/5 border-b border-black/10 dark:border-white/10 text-secondary-text">
                                    <th class="p-3 font-semibold">品牌名称</th>
                                    <th class="p-3 font-semibold">核心线路架构</th>
